{
  "name": "astro-personal-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --test scripts/*.test.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "verify": "node scripts/verify-build.mjs",
    "checks": "npm run check && npm test && npm run build && npm run verify",
    "publish:cv": "node scripts/publish-cv.mjs",
    "update:publications": "node scripts/update-publications.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.11.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {}
}
