---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import AnchorNav from "../components/AnchorNav.astro";
import AboutSection from "../components/AboutSection.astro";
import TalksSection from "../components/TalksSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { personId, personNode } from "../lib/schema";

const profile = (await getEntry("site", "profile"))!.data;
const about = (await getEntry("about", "main"))!;
const { Content: AboutContent } = await render(about);
const services = (await getEntry("services", "main"))!.data.items;
const talks = (await getEntry("talks", "main"))!.data.items;

const cvFilenameMatch = profile.cvFile.match(/^KaiWU_CV_(\d{4})(\d{2})(\d{2})(?:-\d+)?\.pdf$/);
if (!cvFilenameMatch) {
  throw new Error("profile.cvFile must match KaiWU_CV_YYYYMMDD[-N].pdf");
}

const [, year, month, day] = cvFilenameMatch;
const cvDate = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)));
if (
  cvDate.getUTCFullYear() !== Number(year) ||
  cvDate.getUTCMonth() !== Number(month) - 1 ||
  cvDate.getUTCDate() !== Number(day)
) {
  throw new Error("profile.cvFile contains an invalid date");
}

const cvUpdatedIso = `${year}-${month}-${day}`;
const cvUpdatedDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC"
}).format(cvDate);

const siteUrl = profile.canonical;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    personNode(profile),
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}#profile-page`,
      url: siteUrl,
      name: "Kai Wu | Computational Astrophysicist",
      mainEntity: { "@id": personId }
    },
    ...talks.map((talk) => ({
      "@type": "PresentationDigitalDocument",
      "@id": new URL(talk.slides ?? `#talks-${talk.id}`, siteUrl).toString(),
      name: talk.title,
      description: talk.summary,
      url: new URL(talk.slides ?? `#talks-${talk.id}`, siteUrl).toString(),
      datePublished: talk.date.toISOString().slice(0, 10),
      inLanguage: "en",
      author: { "@id": personId },
      contentLocation: { "@type": "Place", name: talk.venue },
      ...(talk.pdf && {
        encoding: {
          "@type": "MediaObject",
          encodingFormat: "application/pdf",
          contentUrl: new URL(talk.pdf, siteUrl).toString()
        }
      })
    }))
  ]
};
---

<BaseLayout
  title="Kai Wu | Computational Astrophysicist"
  description={profile.description}
  canonicalPath="/"
  image={profile.socialImage}
  ogType="profile"
  jsonLd={jsonLd}
>
  <main>
    <Sidebar profile={profile} />

    <div class="main-content">
      <AnchorNav />
      <AboutSection
        about={about.data}
        services={services}
        cvFile={profile.cvFile}
        cvUpdatedDate={cvUpdatedDate}
        cvUpdatedIso={cvUpdatedIso}
        profileLinks={profile.socials}
      >
        <AboutContent />
      </AboutSection>
      <TalksSection talks={talks} />
      <ContactSection emails={profile.emails} />
    </div>
  </main>
</BaseLayout>
