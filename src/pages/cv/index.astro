---
import { getEntry } from "astro:content";

const profile = (await getEntry("site", "profile"))!.data;
const cvHref = `/${profile.cvFile}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0; url=${cvHref}`}>
    <meta name="robots" content="noindex">
    <link rel="canonical" href={`https://wukai.work/${profile.cvFile}`}>
    <title>CV | Kai Wu</title>
  </head>
  <body>
    <p>Redirecting to <a href={cvHref} data-goatcounter-click="cv-pdf" data-goatcounter-title="Download CV">Kai Wu's CV</a>.</p>
    <script is:inline data-goatcounter="https://wukai.goatcounter.com/count" async src="/assets/goatcounter-count-v20260928.js"></script>
  </body>
</html>
